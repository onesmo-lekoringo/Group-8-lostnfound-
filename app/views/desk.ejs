<header class="page-intro desk-head">
  <div>
    <h1>Security desk</h1>
    <p class="lede">Check an ID in person before you release anything. Names and contacts on this page are not shown on the public register.</p>
  </div>
  <form method="post" action="/desk/lock">
    <button class="button ghost" type="submit">Sign out</button>
  </form>
</header>

<section>
  <div class="section-head">
    <h2>Claims to decide</h2>
  </div>
  <% if (!pending.length) { %>
    <p class="quiet">No claims are waiting.</p>
  <% } else { %>
    <div class="stack">
      <% pending.forEach(function (claim) { %>
        <article class="queue-card">
          <div class="record-top">
            <span class="record-ref"><%= claim.item.ref %></span>
            <%- include('partials/stamp', { item: claim.item }) %>
          </div>
          <h3><a href="/items/<%= claim.item.id %>"><%= claim.item.title %></a></h3>
          <p class="record-meta"><%= locationLabel(claim.item) %> · filed <%= formatWhen(claim.createdAt) %></p>
          <p><strong><%= claim.name %></strong> · ID <%= claim.studentId %> · <%= claim.contact %></p>
          <blockquote><%= claim.proof %></blockquote>
          <p class="quiet">Public description: <%= claim.item.description %></p>
          <div class="actions">
            <form method="post" action="/desk/claims/<%= claim.id %>/approve">
              <button class="button gold" type="submit">Approve and release</button>
            </form>
            <form method="post" action="/desk/claims/<%= claim.id %>/reject">
              <button class="button ghost" type="submit">Decline claim</button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section>
  <div class="section-head">
    <h2>Notes on lost reports</h2>
  </div>
  <% if (!leads.length) { %>
    <p class="quiet">No sighting notes yet.</p>
  <% } else { %>
    <div class="stack">
      <% leads.forEach(function (lead) { %>
        <article class="queue-card quiet-card">
          <p class="record-ref"><a href="/items/<%= lead.item.id %>"><%= lead.item.ref %></a> · <%= lead.item.title %></p>
          <p><strong><%= lead.name %></strong> · <%= lead.contact %> · <%= formatWhen(lead.createdAt) %></p>
          <p><%= lead.message %></p>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section>
  <div class="section-head">
    <h2>Found items still open</h2>
  </div>
  <% if (!holding.length) { %>
    <p class="quiet">No found items are waiting.</p>
  <% } else { %>
    <div class="stack">
      <% holding.forEach(function (item) { %>
        <article class="queue-card quiet-card">
          <div class="record-top">
            <span class="record-ref"><%= item.ref %></span>
            <%- include('partials/stamp', { item: item }) %>
          </div>
          <h3><a href="/items/<%= item.id %>"><%= item.title %></a></h3>
          <p class="record-meta"><%= locationLabel(item) %><% if (item.desk) { %> · <%= item.desk %><% } %></p>
          <p>Logged by <%= item.reporterName %> (<%= item.reporterRole %>) · <%= item.reporterContact %><% if (item.studentId) { %> · ID <%= item.studentId %><% } %></p>
          <% if (item.status === 'review') { %>
            <p class="note">A claim is waiting. Approve or decline it above before a walk-in release.</p>
          <% } else { %>
            <details class="drawer" <%= errorItem === item.id ? 'open' : '' %>>
              <summary>Walk-in release</summary>
              <form class="form-grid" method="post" action="/desk/items/<%= item.id %>/release">
                <div class="field">
                  <label for="rel-name-<%= item.id %>">Collector name</label>
                  <input id="rel-name-<%= item.id %>" name="name" maxlength="80" required>
                </div>
                <div class="field">
                  <label for="rel-id-<%= item.id %>">ID checked</label>
                  <input id="rel-id-<%= item.id %>" name="studentId" maxlength="20" required>
                </div>
                <div class="field span-2">
                  <label for="rel-note-<%= item.id %>">Note, optional</label>
                  <input id="rel-note-<%= item.id %>" name="note" maxlength="200">
                </div>
                <div class="span-2"><button class="button" type="submit">Mark returned</button></div>
              </form>
            </details>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section>
  <div class="section-head">
    <h2>Lost reports still open</h2>
  </div>
  <% if (!missing.length) { %>
    <p class="quiet">No open lost reports.</p>
  <% } else { %>
    <div class="stack">
      <% missing.forEach(function (item) { %>
        <article class="queue-card quiet-card">
          <div class="record-top">
            <span class="record-ref"><%= item.ref %></span>
            <%- include('partials/stamp', { item: item }) %>
          </div>
          <h3><a href="/items/<%= item.id %>"><%= item.title %></a></h3>
          <p class="record-meta"><%= locationLabel(item) %> · <%= formatDay(item.occurredOn) %></p>
          <p>Filed by <%= item.reporterName %> · <%= item.reporterContact %><% if (item.studentId) { %> · ID <%= item.studentId %><% } %></p>
          <form method="post" action="/desk/items/<%= item.id %>/resolve">
            <button class="button ghost" type="submit">Mark resolved</button>
          </form>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section>
  <div class="section-head">
    <h2>Recently closed</h2>
  </div>
  <% if (!closed.length) { %>
    <p class="quiet">Nothing closed yet.</p>
  <% } else { %>
    <ul class="records">
      <% closed.forEach(function (item) { %>
        <li>
          <a class="record record-<%= statusMeta(item).key %>" href="/items/<%= item.id %>">
            <span class="record-top">
              <span class="record-ref"><%= item.ref %></span>
              <%- include('partials/stamp', { item: item }) %>
            </span>
            <span class="record-title"><%= item.title %></span>
            <span class="record-meta">
              <% if (item.returnedTo) { %>Released to <%= item.returnedTo %><% if (item.returnedToId) { %> · ID <%= item.returnedToId %><% } %><% if (item.releaseNote) { %> · <%= item.releaseNote %><% } %>
              <% } else { %>Closed <%= item.returnedAt ? formatWhen(item.returnedAt) : '' %><% } %>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<% if (decisions.length) { %>
  <section>
    <div class="section-head">
      <h2>Recent claim decisions</h2>
    </div>
    <ul class="plain">
      <% decisions.forEach(function (claim) { %>
        <li><%= formatWhen(claim.resolvedAt) %> — <%= claim.status %> claim by <%= claim.name %> on <%= claim.item.ref %> <%= claim.item.title %></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<section class="panel">
  <h2>Desk code</h2>
  <p>The code lives in the register. Changing it here updates the file. It is still shown on the sign-in card so this demo stays usable.</p>
  <form class="unlock" method="post" action="/desk/code">
    <label for="new-code">New code (4–8 digits)</label>
    <input id="new-code" name="code" inputmode="numeric" maxlength="8" value="<%= settings.deskCode %>" required>
    <button class="button" type="submit">Update code</button>
  </form>
</section>
