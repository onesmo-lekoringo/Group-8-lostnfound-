<section class="hero">
  <div>
    <p class="eyebrow"><span>Lost & Found</span> USIU-Africa, Nairobi</p>
    <h1>What the campus leaves behind.</h1>
    <p class="lede">Report a lost item, log something you found, and search the same list the security desks use. Classrooms, labs, the library, the cafeteria — one register.</p>
    <form class="search" action="/items" method="get">
      <label class="sr-only" for="home-q">Search the register</label>
      <input id="home-q" name="q" type="search" placeholder="Laptop, library, student ID, OB-2026…" maxlength="80">
      <button class="button gold" type="submit">Search</button>
    </form>
    <div class="hero-actions">
      <a class="button lost" href="/report?kind=lost">I lost something</a>
      <a class="button found" href="/report?kind=found">I found something</a>
    </div>
  </div>
  <aside class="desk-board" aria-label="At the security desk">
    <h2>At the security desk</h2>
    <% if (!slips.length) { %>
      <p class="quiet">Nothing is waiting at a desk right now.</p>
    <% } else { %>
      <ol class="slips">
        <% slips.forEach(function (item) { %>
          <li>
            <a class="slip slip-<%= statusMeta(item).key %>" href="/items/<%= item.id %>">
              <span class="slip-kicker"><%= item.ref %></span>
              <strong><%= item.title %></strong>
              <span class="meta"><%= locationLabel(item) %></span>
            </a>
          </li>
        <% }) %>
      </ol>
    <% } %>
  </aside>
</section>

<section class="stats" aria-label="Register summary">
  <a class="stat stat-missing" href="/items?kind=lost&status=open">
    <span class="stat-num"><%= stats.missing %></span>
    <span class="stat-label">Lost reports still open</span>
  </a>
  <a class="stat stat-desk" href="/items?status=desk">
    <span class="stat-num"><%= stats.atDesk %></span>
    <span class="stat-label">Held at a security desk</span>
  </a>
  <a class="stat stat-review" href="/desk">
    <span class="stat-num"><%= stats.review %></span>
    <span class="stat-label">Claims waiting on an ID check</span>
  </a>
  <a class="stat stat-returned" href="/items?kind=found&status=closed">
    <span class="stat-num"><%= stats.returned %></span>
    <span class="stat-label">Items already returned</span>
  </a>
</section>

<blockquote class="pull">Found property is labeled, recorded, and kept at a security desk. Use your ID when you lay a claim.</blockquote>

<div class="split">
  <section>
    <div class="section-head">
      <h2><span class="swatch swatch-lost" aria-hidden="true"></span>Still missing</h2>
      <a href="/items?kind=lost&status=open">All lost reports</a>
    </div>
    <% if (!lostPreview.length) { %>
      <p class="quiet">No open lost reports.</p>
    <% } else { %>
      <ul class="records">
        <% lostPreview.forEach(function (item) { %>
          <li><%- include('partials/item-row', { item: item, matchIds: matchIds }) %></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
  <section>
    <div class="section-head">
      <h2><span class="swatch swatch-found" aria-hidden="true"></span>Recently handed in</h2>
      <a href="/items?kind=found&status=open">All found items</a>
    </div>
    <% if (!foundPreview.length) { %>
      <p class="quiet">No open found items.</p>
    <% } else { %>
      <ul class="records">
        <% foundPreview.forEach(function (item) { %>
          <li><%- include('partials/item-row', { item: item, matchIds: matchIds }) %></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<section>
  <div class="section-head">
    <h2>How a return actually happens</h2>
  </div>
  <ol class="steps">
    <li class="step">
      <b>1 — Report</b>
      <p>File what you lost, or log what you found. If you found it, hand it to the nearest security desk and keep the OB number.</p>
    </li>
    <li class="step">
      <b>2 — Search</b>
      <p>Look through the same register the desks use. Filter by place, category, or the reference on your slip.</p>
    </li>
    <li class="step">
      <b>3 — Reclaim</b>
      <p>File a claim with your ID and something only the owner would know. Collect the item at the desk after it is checked.</p>
    </li>
  </ol>
</section>

<% if (hotPlaces.length) { %>
  <section>
    <div class="section-head">
      <h2>Places named most often</h2>
    </div>
    <div class="chips">
      <% hotPlaces.forEach(function (entry) { %>
        <a href="/items?place=<%= encodeURIComponent(entry.place) %>"><%= entry.place %> <span><%= entry.count %></span></a>
      <% }) %>
    </div>
  </section>
<% } %>
