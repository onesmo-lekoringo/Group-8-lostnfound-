<p class="crumbs"><a href="/items">Register</a> <span aria-hidden="true">/</span> <%= item.ref %></p>
<article class="item-sheet">
  <div class="record-top">
    <span class="record-ref"><%= kindLabel(item.kind) %> · <%= item.ref %></span>
    <%- include('partials/stamp', { item: item }) %>
  </div>
  <h1><%= item.title %></h1>
  <dl class="detail-grid">
    <div><dt class="k">Category</dt><dd><%= item.category %></dd></div>
    <% if (item.color) { %><div><dt class="k">Colour</dt><dd><%= item.color %></dd></div><% } %>
    <div><dt class="k">Place</dt><dd><%= locationLabel(item) %></dd></div>
    <div><dt class="k">Date</dt><dd><%= formatDay(item.occurredOn) %></dd></div>
    <% if (item.kind === 'found' && item.custody === 'desk' && item.desk) { %>
      <div><dt class="k">Held at</dt><dd><%= item.desk %></dd></div>
    <% } %>
    <% if (item.status === 'returned' && item.returnedAt) { %>
      <div><dt class="k">Returned</dt><dd><%= formatWhen(item.returnedAt) %></dd></div>
    <% } %>
  </dl>
  <p class="description"><%= item.description %></p>
  <% if (item.kind === 'found' && item.custody === 'finder' && item.status === 'open') { %>
    <p class="note">The finder still has this. A claim goes to the security desk, who will arrange the hand-over.</p>
  <% } %>
  <% if (item.status === 'returned') { %>
    <p class="note">This item was released to its owner at a security desk.</p>
  <% } %>
  <% if (item.status === 'resolved') { %>
    <p class="note">This lost report is closed.</p>
  <% } %>
</article>

<% if (matches.length) { %>
  <section>
    <div class="section-head">
      <h2>Possible matches</h2>
    </div>
    <ul class="matches">
      <% matches.forEach(function (match) { %>
        <li>
          <a class="match-<%= statusMeta(match.item).key %>" href="/items/<%= match.item.id %>">
            <span class="record-top">
              <span class="record-ref"><%= match.item.ref %></span>
              <%- include('partials/stamp', { item: match.item }) %>
            </span>
            <strong><%= match.item.title %></strong>
            <span class="record-meta"><%= match.reasons.join(' · ') %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<section>
  <div class="section-head">
    <h2>What has happened</h2>
  </div>
  <ol class="timeline">
    <% (item.events || []).forEach(function (event) { %>
      <li>
        <time datetime="<%= event.at %>"><%= formatWhen(event.at) %></time>
        <%= event.text %>
      </li>
    <% }) %>
  </ol>
</section>

<% if (item.kind === 'found' && item.status === 'open') { %>
  <section class="panel">
    <h2>Is this yours?</h2>
    <p>Tell the desk something that is not already written above, and bring the same ID when you collect it. The desk decides — filing a claim does not reserve the item.</p>
    <form class="form-grid" method="post" action="/items/<%= item.id %>/claim">
      <div class="field">
        <label for="claim-name">Name on your ID <span class="req">Required</span></label>
        <input id="claim-name" name="name" autocomplete="name" maxlength="80" required value="<%= form === 'claim' ? (values.name || '') : '' %>" aria-invalid="<%= errors.name ? 'true' : 'false' %>">
        <% if (errors.name) { %><p class="field-error" id="claim-name-error"><%= errors.name %></p><% } %>
      </div>
      <div class="field">
        <label for="claim-id">Student or staff ID <span class="req">Required</span></label>
        <input id="claim-id" name="studentId" maxlength="20" required value="<%= form === 'claim' ? (values.studentId || '') : '' %>" aria-invalid="<%= errors.studentId ? 'true' : 'false' %>">
        <% if (errors.studentId) { %><p class="field-error"><%= errors.studentId %></p><% } %>
      </div>
      <div class="field span-2">
        <label for="claim-contact">Phone or email <span class="req">Required</span></label>
        <input id="claim-contact" name="contact" autocomplete="email" maxlength="80" required value="<%= form === 'claim' ? (values.contact || '') : '' %>" aria-invalid="<%= errors.contact ? 'true' : 'false' %>">
        <% if (errors.contact) { %><p class="field-error"><%= errors.contact %></p><% } %>
      </div>
      <div class="field span-2">
        <label for="claim-proof">Something only the owner would know <span class="req">Required</span></label>
        <textarea id="claim-proof" name="proof" maxlength="500" required aria-invalid="<%= errors.proof ? 'true' : 'false' %>"><%= form === 'claim' ? (values.proof || '') : '' %></textarea>
        <% if (errors.proof) { %><p class="field-error"><%= errors.proof %></p><% } %>
      </div>
      <div class="span-2"><button class="button gold" type="submit">File a claim</button></div>
    </form>
  </section>
<% } else if (item.kind === 'found' && pendingClaim) { %>
  <section class="panel">
    <h2>A claim is already in review</h2>
    <p>The security desk is checking it against an ID. If you also believe this is yours, go to the desk with your ID rather than filing a second claim online.</p>
  </section>
<% } else if (item.kind === 'lost' && item.status === 'open') { %>
  <section class="panel">
    <h2>Have you seen it?</h2>
    <p>Send a note to the security desk. Your contact is not published on the register.</p>
    <form class="form-grid" method="post" action="/items/<%= item.id %>/lead">
      <div class="field">
        <label for="lead-name">Your name <span class="req">Required</span></label>
        <input id="lead-name" name="name" autocomplete="name" maxlength="80" required value="<%= form === 'lead' ? (values.name || '') : '' %>">
        <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
      </div>
      <div class="field">
        <label for="lead-contact">Phone or email <span class="req">Required</span></label>
        <input id="lead-contact" name="contact" maxlength="80" required value="<%= form === 'lead' ? (values.contact || '') : '' %>">
        <% if (errors.contact) { %><p class="field-error"><%= errors.contact %></p><% } %>
      </div>
      <div class="field span-2">
        <label for="lead-message">Where and when <span class="req">Required</span></label>
        <textarea id="lead-message" name="message" maxlength="500" required><%= form === 'lead' ? (values.message || '') : '' %></textarea>
        <% if (errors.message) { %><p class="field-error"><%= errors.message %></p><% } %>
      </div>
      <div class="span-2"><button class="button" type="submit">Send note to the desk</button></div>
    </form>
  </section>
<% } %>
