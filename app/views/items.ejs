<header class="page-intro">
  <h1>The register</h1>
  <p class="lede">Every lost report and found item filed by the USIU-Africa community. Contacts stay with the security desk — this list shows the item, not the person.</p>
</header>

<form class="filters" action="/items" method="get">
  <div class="field span-2">
    <label for="q">Search</label>
    <input id="q" name="q" type="search" value="<%= query.q %>" maxlength="80" placeholder="Title, place, colour, reference">
  </div>
  <div class="field">
    <label for="kind">Type</label>
    <select id="kind" name="kind">
      <option value="all" <%= query.kind === 'all' ? 'selected' : '' %>>Lost and found</option>
      <option value="lost" <%= query.kind === 'lost' ? 'selected' : '' %>>Lost reports</option>
      <option value="found" <%= query.kind === 'found' ? 'selected' : '' %>>Found items</option>
    </select>
  </div>
  <div class="field">
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="all" <%= query.status === 'all' ? 'selected' : '' %>>Any status</option>
      <option value="open" <%= query.status === 'open' ? 'selected' : '' %>>Still open</option>
      <option value="desk" <%= query.status === 'desk' ? 'selected' : '' %>>At a security desk</option>
      <option value="review" <%= query.status === 'review' ? 'selected' : '' %>>Claim in review</option>
      <option value="closed" <%= query.status === 'closed' ? 'selected' : '' %>>Returned or resolved</option>
    </select>
  </div>
  <div class="field">
    <label for="category">Category</label>
    <select id="category" name="category">
      <option value="all">Any category</option>
      <% categories.forEach(function (category) { %>
        <option value="<%= category %>" <%= query.category === category ? 'selected' : '' %>><%= category %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="place">Place</label>
    <select id="place" name="place">
      <option value="all">Anywhere on campus</option>
      <% places.forEach(function (place) { %>
        <option value="<%= place %>" <%= query.place === place ? 'selected' : '' %>><%= place %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="sort">Order</label>
    <select id="sort" name="sort">
      <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest first</option>
      <option value="oldest" <%= query.sort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
    </select>
  </div>
  <div class="filter-actions">
    <button class="button gold" type="submit">Apply</button>
    <% if (hasFilters) { %><a class="button ghost" href="/items">Reset</a><% } %>
  </div>
</form>

<p class="result-count"><%= plural(pageResult.total, 'record') %><% if (pageResult.pages > 1) { %> · page <%= pageResult.current %> of <%= pageResult.pages %><% } %></p>

<% if (!pageResult.slice.length) { %>
  <div class="empty">
    <h2>Nothing matches</h2>
    <p>Try a shorter word, another place, or file a report if it is not here yet.</p>
    <a class="button" href="/report">File a report</a>
  </div>
<% } else { %>
  <ul class="records">
    <% pageResult.slice.forEach(function (item) { %>
      <li><%- include('partials/item-row', { item: item, matchIds: matchIds }) %></li>
    <% }) %>
  </ul>
  <% if (pageResult.pages > 1) { %>
    <nav class="pager" aria-label="Pages">
      <% if (pageResult.current > 1) { %>
        <a href="<%= hrefWith('/items', query, { page: pageResult.current - 1 }) %>">Previous</a>
      <% } %>
      <span>Page <%= pageResult.current %> of <%= pageResult.pages %></span>
      <% if (pageResult.current < pageResult.pages) { %>
        <a href="<%= hrefWith('/items', query, { page: pageResult.current + 1 }) %>">Next</a>
      <% } %>
    </nav>
  <% } %>
<% } %>
