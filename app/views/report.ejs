<header class="page-intro">
  <h1>File a report</h1>
  <p class="lede">Lost reports help the desk watch for a match. Found items should be handed to the nearest security desk — you will get an OB number on this register.</p>
</header>

<form class="panel form-grid" method="post" action="/report">
  <fieldset class="span-2 choices">
    <legend>What are you reporting?</legend>
    <div class="choice-row">
      <label class="choice">
        <input type="radio" name="kind" value="lost" <%= values.kind !== 'found' ? 'checked' : '' %>>
        <span><strong>I lost something</strong><small>File a missing report.</small></span>
      </label>
      <label class="choice">
        <input type="radio" name="kind" value="found" <%= values.kind === 'found' ? 'checked' : '' %>>
        <span><strong>I found something</strong><small>Log it and hand it to a desk.</small></span>
      </label>
    </div>
    <% if (errors.kind) { %><p class="field-error"><%= errors.kind %></p><% } %>
  </fieldset>

  <div class="only-found span-2">
    <fieldset class="choices">
      <legend>Where is the item now?</legend>
      <div class="choice-row">
        <label class="choice">
          <input type="radio" name="handIn" value="desk" <%= values.handIn !== 'finder' ? 'checked' : '' %>>
          <span><strong>At a security desk</strong><small>It has been handed in.</small></span>
        </label>
        <label class="choice">
          <input type="radio" name="handIn" value="finder" <%= values.handIn === 'finder' ? 'checked' : '' %>>
          <span><strong>Still with me</strong><small>I will hand it in.</small></span>
        </label>
      </div>
      <% if (errors.handIn) { %><p class="field-error"><%= errors.handIn %></p><% } %>
    </fieldset>
    <div class="field only-desk">
      <label for="desk">Which desk <span class="req">Required if handed in</span></label>
      <select id="desk" name="desk">
        <option value="">Choose</option>
        <% desks.forEach(function (desk) { %>
          <option value="<%= desk %>" <%= values.desk === desk ? 'selected' : '' %>><%= desk %></option>
        <% }) %>
      </select>
      <% if (errors.desk) { %><p class="field-error"><%= errors.desk %></p><% } %>
    </div>
  </div>

  <div class="field span-2">
    <label for="title">Item name <span class="req">Required</span></label>
    <input id="title" name="title" required maxlength="80" value="<%= values.title || '' %>" placeholder="Black HP laptop, blue calculus book…">
    <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
  </div>
  <div class="field">
    <label for="category">Category <span class="req">Required</span></label>
    <select id="category" name="category" required>
      <option value="">Choose</option>
      <% categories.forEach(function (category) { %>
        <option value="<%= category %>" <%= values.category === category ? 'selected' : '' %>><%= category %></option>
      <% }) %>
    </select>
    <% if (errors.category) { %><p class="field-error"><%= errors.category %></p><% } %>
  </div>
  <div class="field">
    <label for="color">Colour</label>
    <input id="color" name="color" maxlength="40" value="<%= values.color || '' %>" placeholder="Black, navy, silver…">
  </div>
  <div class="field span-2">
    <label for="description">Details someone could recognise <span class="req">Required</span></label>
    <textarea id="description" name="description" required maxlength="800" placeholder="Marks, stickers, what is inside, a name written on it — leave out passwords and full ID numbers."><%= values.description || '' %></textarea>
    <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } %>
  </div>
  <div class="field">
    <label for="place">Place on campus <span class="req">Required</span></label>
    <select id="place" name="place" required>
      <option value="">Choose</option>
      <% places.forEach(function (place) { %>
        <option value="<%= place %>" <%= values.place === place ? 'selected' : '' %>><%= place %></option>
      <% }) %>
    </select>
    <% if (errors.place) { %><p class="field-error"><%= errors.place %></p><% } %>
  </div>
  <div class="field">
    <label for="detail">Where exactly</label>
    <input id="detail" name="detail" maxlength="80" value="<%= values.detail || '' %>" placeholder="Level 2, lab 3, seat row…">
  </div>
  <div class="field">
    <label for="occurredOn">Date lost or found <span class="req">Required</span></label>
    <input id="occurredOn" name="occurredOn" type="date" required max="<%= today %>" value="<%= values.occurredOn || today %>">
    <% if (errors.occurredOn) { %><p class="field-error"><%= errors.occurredOn %></p><% } %>
  </div>
  <div class="field">
    <label for="reporterRole">You are <span class="req">Required</span></label>
    <select id="reporterRole" name="reporterRole" required>
      <option value="">Choose</option>
      <% roles.forEach(function (role) { %>
        <option value="<%= role %>" <%= values.reporterRole === role ? 'selected' : '' %>><%= role %></option>
      <% }) %>
    </select>
    <% if (errors.reporterRole) { %><p class="field-error"><%= errors.reporterRole %></p><% } %>
  </div>

  <div class="field">
    <label for="reporterName">Your name <span class="req">Required</span></label>
    <input id="reporterName" name="reporterName" autocomplete="name" required maxlength="80" value="<%= values.reporterName || '' %>">
    <% if (errors.reporterName) { %><p class="field-error"><%= errors.reporterName %></p><% } %>
  </div>
  <div class="field">
    <label for="studentId">Student or staff ID</label>
    <input id="studentId" name="studentId" maxlength="20" value="<%= values.studentId || '' %>">
    <% if (errors.studentId) { %><p class="field-error"><%= errors.studentId %></p><% } %>
  </div>
  <div class="field span-2">
    <label for="reporterContact">Phone or email <span class="req">Required</span></label>
    <input id="reporterContact" name="reporterContact" autocomplete="email" required maxlength="80" value="<%= values.reporterContact || '' %>" placeholder="The desk sees this. It is not published.">
    <% if (errors.reporterContact) { %><p class="field-error"><%= errors.reporterContact %></p><% } %>
  </div>
  <div class="span-2">
    <button class="button gold" type="submit">Save to the register</button>
  </div>
</form>
