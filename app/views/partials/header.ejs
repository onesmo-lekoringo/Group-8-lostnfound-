<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <div class="brand-bar"></div>
  <div class="header-inner">
    <a class="brand" href="/">
      <svg viewBox="0 0 42 42" aria-hidden="true">
        <rect width="42" height="42" rx="4" fill="#1c1c1c"></rect>
        <rect x="6" y="6" width="30" height="30" fill="none" stroke="#f4f4f4" stroke-width="1.5"></rect>
        <text x="21" y="27" text-anchor="middle" font-family="Georgia, serif" font-size="13" font-weight="700" fill="#f4f4f4">LF</text>
      </svg>
      <span class="brand-name">
        <small>USIU-Africa</small>
        <strong>Lost & Found</strong>
      </span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/items" <% if (path === '/items') { %>aria-current="page"<% } %>>Register</a>
      <a href="/report" <% if (path === '/report') { %>aria-current="page"<% } %>>Report</a>
      <a href="/desk" <% if (path === '/desk') { %>aria-current="page"<% } %>>
        Security desk
        <% if (pendingCount) { %><span class="badge"><%= pendingCount %></span><% } %>
      </a>
    </nav>
    <% if (deskOn) { %><span class="desk-pill">Desk open</span><% } %>
  </div>
</header>
